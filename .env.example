# --- Genesis RAG settings ---
PROJECT_NAME="Genesis RAG"
DEBUG=False

# Infrastructure
REDIS_URL="redis://localhost:6379"
CHROMA_PERSIST_DIRECTORY="chroma_db"   # Chroma runs embedded, no separate server needed
NUM_SHARDS=16

# Google Gemini (required): https://aistudio.google.com/apikey
GOOGLE_API_KEY="your-google-api-key-here"
GEMINI_MODEL="gemini-3-flash-preview"
GEMINI_PRO_MODEL="gemini-3.1-pro-preview"

# Optional services
TAVILY_API_KEY=""     # web search fallback for Corrective RAG
OPENAI_API_KEY=""     # only for the graph reasoning agent (needs Neo4j too)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"
OPIK_API_KEY=""
OPIK_HOST="http://localhost:8080"
OPIK_PROJECT_NAME="genesis-rag"

# API security
# CORS origins: "*", a comma separated list, or a JSON list
ALLOWED_HOSTS="http://localhost:3000,http://127.0.0.1:3000"
API_KEY=""                    # if set, clients must send an X-API-Key header
RATE_LIMIT_PER_MINUTE=120     # per IP, 0 disables
MAX_UPLOAD_MB=25

# Hosting (see README "Deploy to Render")
SEED_DEMO_DOCS=false          # index demo_docs/ on startup when the knowledge base is empty
